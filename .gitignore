# macOS
.DS_Store

# Node / 前端
node_modules/
frontend/dist/
frontend/.vite/
# TypeScript 增量构建缓存（每次 tsc 都会变更，不入库）
frontend/*.tsbuildinfo

# Rust
target/
src-tauri/target/

# IDE
.idea/
.vscode/
*.swp

# 内部文档（评审/规划类，不入库）
docs/
artifacts/

# Tauri updater 签名私钥（绝不可提交；公钥在 tauri.conf.json）
src-tauri/.signing/

# 个人数据保护：dev-tools/ 仅存本机（历史清洗脚本+个人黑名单），绝不入库
dev-tools/

