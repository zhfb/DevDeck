#!/usr/bin/env bash
# =====================================================================
# DevDeck pre-commit —— 提交前拦截个人数据与密钥
#
# 拦截内容：
#   1. 敏感文件类型/文件名（.env、私钥、数据库、抓包等）
#   2. 通用密钥/凭据特征（私钥块、GitHub token、云厂商 AK、OpenAI key 等）
#   3. 公网 IPv4 地址（允许 127.0.0.1 / 私网 / TEST-NET 文档地址）
#   4. dev-tools/blocklist.txt 中列出的个人数据关键字（该文件被 gitignore，仅本机生效）
#
# 启用：git config core.hooksPath .githooks
# 说明：本钩子只读取暂存区内容，不会修改任何文件。
# =====================================================================
set -euo pipefail

echo "🔍 pre-commit：检查个人数据 / 密钥…"

# ---- 1) 禁止提交的敏感文件（按文件名/扩展名） ----
declare -a bad_files=()
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    *.env|*.env.*|*.pem|*.p12|*.pfx|*.key|*.p8|*.pcap|*.db|*.sqlite|*.sqlite3|*.keystore|*.jks|*.der)
      bad_files+=("$f") ;;
    */id_rsa|*/id_dsa|*/id_ecdsa|*/id_ed25519)
      bad_files+=("$f") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM)
if [ ${#bad_files[@]} -gt 0 ]; then
  echo "❌ 检测到敏感文件被暂存（禁止提交）："
  printf '   %s\n' "${bad_files[@]}"
  exit 1
fi

# ---- 2) 通用密钥/凭据特征（ERE，macOS grep -E 兼容） ----
SECRET_RE='-----BEGIN [A-Z ]*PRIVATE KEY-----|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|sk-[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{30,}'

# ---- 3) 公网 IPv4 检测（awk，macOS 原生可用） ----
# 允许：127.0.0.1、10.x、172.16-31.x、192.168.x、TEST-NET(192.0.2/198.51.100/203.0.113)
check_public_ip() {
  awk '
    function is_allowed(ip,  a) {
      split(ip, a, ".")
      if (a[1] == 0 && a[2] == 0 && a[3] == 0 && a[4] == 0) return 1  # 0.0.0.0 通配地址，非公网
      if (a[1] == 10) return 1
      if (a[1] == 127) return 1
      if (a[1] == 192 && a[2] == 168) return 1
      if (a[1] == 172 && a[2] >= 16 && a[2] <= 31) return 1
      if (a[1] == 192 && a[2] == 0 && a[3] == 2) return 1
      if (a[1] == 198 && a[2] == 51 && a[3] == 100) return 1
      if (a[1] == 203 && a[2] == 0 && a[3] == 113) return 1
      return 0
    }
    {
      line = $0
      while (match(line, /([0-9]{1,3}\.){3}[0-9]{1,3}/)) {
        ip = substr(line, RSTART, RLENGTH)
        if (!is_allowed(ip)) print ip
        line = substr(line, RSTART + RLENGTH)
      }
    }
  '
}

# ---- 4) 个人数据黑名单（gitignored，仅本机） ----
BLOCKLIST="$(git rev-parse --show-toplevel 2>/dev/null)/dev-tools/blocklist.txt"

fail=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    *.png|*.jpg|*.jpeg|*.gif|*.icns|*.ico|*.pdf|*.lock|*.woff2|*.ttf|*.otf)
      continue ;;   # 跳过二进制/锁文件
  esac
  body="$(git show :"$f" 2>/dev/null || true)"
  [ -n "$body" ] || continue

  # 2) 密钥特征
  if printf '%s' "$body" | grep -qE -- "$SECRET_RE"; then
    echo "❌ $f 疑似包含密钥/凭据"
    fail=1
  fi

  # 3) 公网 IP
  found_ip="$(printf '%s' "$body" | check_public_ip | sed -n '1p' || true)"
  if [ -n "$found_ip" ]; then
    echo "❌ $f 包含公网 IP: ${found_ip}（疑似个人服务器地址）"
    fail=1
  fi

  # 4) 个人数据黑名单
  if [ -f "$BLOCKLIST" ]; then
    while IFS= read -r pat; do
      if [ -z "$pat" ] || [ "${pat#\#}" != "$pat" ]; then
        continue
      fi
      if printf '%s' "$body" | grep -qF -- "$pat"; then
        echo "❌ $f 命中个人数据黑名单: $pat"
        fail=1
      fi
    done < "$BLOCKLIST"
  fi
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ "$fail" -ne 0 ]; then
  echo "🚫 提交已拦截。请移除上述个人数据 / 密钥后，重新 git add 再 commit。"
  echo "   （如确为误报，可临时用 git commit --no-verify 绕过，但请谨慎）"
  exit 1
fi
echo "✅ pre-commit 检查通过"
